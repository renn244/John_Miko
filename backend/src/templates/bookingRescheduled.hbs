<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking Rescheduled</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 560px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px;">
            <tr>
              <td style="padding: 36px 40px 20px; border-bottom: 1px solid #e2e8f0;">
                <div style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 18px;">
                  John Miko's Place
                </div>
                <div style="font-size: 22px; font-weight: 700; line-height: 1.3; color: #0f172a;">
                  Your booking schedule has been updated
                </div>
                <div style="margin-top: 8px; font-size: 14px; line-height: 1.6; color: #475569;">
                  Hi{{#if guestName}} {{guestName}}{{/if}}, the schedule for your reservation has been updated. Please review the new details below.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 28px 40px;">
                <div style="display: inline-block; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #b45309; margin-bottom: 18px;">
                  Booking Rescheduled
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Booking Reference</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{bookingReference}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Accommodation</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{accommodationName}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Previous schedule</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{previousBookingDate}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Previous stay option</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{previousStayOptionLabel}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">New schedule</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{newBookingDate}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">New stay option</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{newStayOptionLabel}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <div style="margin-top: 16px; font-size: 12px; line-height: 1.7; color: #64748b;">
                  Please keep this updated schedule for your reference. Contact the resort if you need further changes.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 18px 40px; border-top: 1px solid #e2e8f0; background-color: #f8fafc; font-size: 12px; line-height: 1.6; color: #64748b;">
                This email was sent regarding booking reference {{bookingReference}}.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
