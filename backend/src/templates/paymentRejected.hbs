<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Rejected</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 560px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px;">
            <tr>
              <td style="padding: 36px 40px 20px; border-bottom: 1px solid #e2e8f0;">
                <div style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 18px;">
                  John Miko's Place
                </div>
                <div style="font-size: 22px; font-weight: 700; line-height: 1.3; color: #0f172a;">
                  Your payment was rejected
                </div>
                <div style="margin-top: 8px; font-size: 14px; line-height: 1.6; color: #475569;">
                  Hi{{#if guestName}} {{guestName}}{{/if}}, we could not approve the payment submitted for your booking, so the reservation has been cancelled.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 28px 40px;">
                <div style="display: inline-block; background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #b91c1c; margin-bottom: 18px;">
                  Booking {{bookingStatus}}
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Booking Information</div>
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Booking ID</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{bookingId}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Accommodation</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{accommodationName}}{{#if accommodationType}} &bull; {{accommodationType}}{{/if}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Reservation date</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{bookingDate}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Stay option</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{stayOptionLabel}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Payment Information</div>
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Payment type</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{paymentType}}</td>
                        </tr>
                        {{#if paymentMethodName}}
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Payment method</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{paymentMethodName}}</td>
                        </tr>
                        {{/if}}
                        {{#if referenceNumber}}
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Reference number</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{referenceNumber}}</td>
                        </tr>
                        {{/if}}
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Total amount</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{totalAmount}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Paid now</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{amountPaid}}</td>
                        </tr>
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Remaining balance</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{remainingAmount}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                {{#if rejectionNote}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Rejection Note</div>
                      <div style="background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px 14px; font-size: 12px; line-height: 1.6; color: #9a3412;">
                        {{rejectionNote}}
                      </div>
                    </td>
                  </tr>
                </table>
                {{/if}}

                {{#if myBookingsUrl}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px;">
                  <tr>
                    <td align="center" bgcolor="#2563eb" style="border-radius: 10px;">
                      <a href="{{myBookingsUrl}}" style="display: block; padding: 14px 18px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">View My Bookings</a>
                    </td>
                  </tr>
                </table>
                {{/if}}

                <div style="margin-top: 16px; font-size: 12px; line-height: 1.7; color: #64748b;">
                  You may review your booking history in My Bookings and contact the resort if you need clarification.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 18px 40px; border-top: 1px solid #e2e8f0; background-color: #f8fafc; font-size: 12px; line-height: 1.6; color: #64748b;">
                This email was sent regarding booking {{bookingId}}.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
