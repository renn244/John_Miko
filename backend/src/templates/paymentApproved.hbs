<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Approved</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background-color: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
        color: #0f172a;
        padding: 40px 16px;
      }
      .wrapper { max-width: 560px; margin: 0 auto; }
      .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; }
      .header { padding: 36px 40px 20px; border-bottom: 1px solid #e2e8f0; }
      .brand { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 18px; }
      .title { font-size: 22px; font-weight: 700; line-height: 1.3; }
      .subtitle { margin-top: 8px; font-size: 14px; color: #475569; line-height: 1.6; }
      .body { padding: 28px 40px; }
      .pill { display: inline-block; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #047857; margin-bottom: 18px; }
      .section { margin-top: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; }
      .row { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; line-height: 1.6; margin-top: 8px; }
      .label { color: #64748b; }
      .value { color: #0f172a; font-weight: 600; text-align: right; word-break: break-word; }
      .hint { margin-top: 16px; font-size: 12px; color: #64748b; line-height: 1.7; }
      .section-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 10px; }
      .item { border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 12px; }
      .item:first-of-type { border-top: none; padding-top: 0; margin-top: 0; }
      .item-name { font-size: 13px; font-weight: 600; color: #0f172a; margin-bottom: 8px; }
      .empty { font-size: 12px; color: #64748b; line-height: 1.6; }
      .btn {
        display: block;
        width: 100%;
        background: #2563eb;
        color: #ffffff !important;
        text-decoration: none;
        text-align: center;
        font-size: 14px;
        font-weight: 700;
        padding: 14px 18px;
        border-radius: 10px;
        margin-top: 18px;
      }
      .footer { padding: 18px 40px; border-top: 1px solid #e2e8f0; background: #f8fafc; }
      .footer p { font-size: 12px; color: #64748b; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <div class="brand">John Miko's Place</div>
          <div class="title">Your booking has been confirmed</div>
          <div class="subtitle">
            Hi{{#if guestName}} {{guestName}}{{/if}}, your payment has been approved and your reservation is now confirmed.
          </div>
        </div>

        <div class="body">
          <div class="pill">Booking {{bookingStatus}}</div>

          <div class="section">
            <div class="section-title">Booking Information</div>
            <div class="row">
              <div class="label">Booking ID</div>
              <div class="value">{{bookingId}}</div>
            </div>
            <div class="row">
              <div class="label">Accommodation</div>
              <div class="value">{{accommodationName}}{{#if accommodationType}} • {{accommodationType}}{{/if}}</div>
            </div>
            <div class="row">
              <div class="label">Reservation date</div>
              <div class="value">{{bookingDate}}</div>
            </div>
            <div class="row">
              <div class="label">Stay option</div>
              <div class="value">{{stayOptionLabel}}</div>
            </div>
            <div class="row">
              <div class="label">Guests</div>
              <div class="value">{{guestCount}}</div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">Pre-ordered Items</div>
            {{#if preOrders.length}}
              {{#each preOrders}}
              <div class="item">
                <div class="item-name">{{name}}</div>
                <div class="row">
                  <div class="label">Quantity</div>
                  <div class="value">{{quantity}}</div>
                </div>
                <div class="row">
                  <div class="label">Unit price</div>
                  <div class="value">{{price}}</div>
                </div>
                <div class="row">
                  <div class="label">Subtotal</div>
                  <div class="value">{{subtotal}}</div>
                </div>
              </div>
              {{/each}}
            {{else}}
            <div class="empty">No pre-ordered items.</div>
            {{/if}}
          </div>

          <div class="section">
            <div class="section-title">Add-on Services</div>
            {{#if addOns.length}}
              {{#each addOns}}
              <div class="item">
                <div class="item-name">{{name}}</div>
                <div class="row">
                  <div class="label">Quantity</div>
                  <div class="value">{{quantity}}</div>
                </div>
                <div class="row">
                  <div class="label">Unit price</div>
                  <div class="value">{{price}}</div>
                </div>
                <div class="row">
                  <div class="label">Subtotal</div>
                  <div class="value">{{subtotal}}</div>
                </div>
              </div>
              {{/each}}
            {{else}}
            <div class="empty">No add-on services.</div>
            {{/if}}
          </div>

          <div class="section">
            <div class="section-title">Payment Information</div>
            <div class="row">
              <div class="label">Payment type</div>
              <div class="value">{{paymentType}}</div>
            </div>
            {{#if paymentMethodName}}
            <div class="row">
              <div class="label">Payment method</div>
              <div class="value">{{paymentMethodName}}</div>
            </div>
            {{/if}}
            {{#if referenceNumber}}
            <div class="row">
              <div class="label">Reference number</div>
              <div class="value">{{referenceNumber}}</div>
            </div>
            {{/if}}
            <div class="row">
              <div class="label">Total amount</div>
              <div class="value">{{totalAmount}}</div>
            </div>
            <div class="row">
              <div class="label">Paid now</div>
              <div class="value">{{amountPaid}}</div>
            </div>
            <div class="row">
              <div class="label">Remaining balance</div>
              <div class="value">{{remainingAmount}}</div>
            </div>
          </div>

          {{#if myBookingsUrl}}
          <a class="btn" href="{{myBookingsUrl}}">View My Bookings</a>
          {{/if}}

          <div class="section">
            {{#if specialRequests}}
            <div class="row">
              <div class="label">Special requests</div>
              <div class="value">{{specialRequests}}</div>
            </div>
            {{/if}}
          </div>

          <div class="hint">
            Your reservation is now confirmed. Please keep this email for your check-in reference.
          </div>
        </div>

        <div class="footer">
          <p>This email was sent regarding booking {{bookingId}}.</p>
        </div>
      </div>
    </div>
  </body>
</html>
