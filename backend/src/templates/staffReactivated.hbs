<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Account Reactivated</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background-color: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
        color: #0f172a;
        padding: 40px 16px;
      }
      .wrapper { max-width: 560px; margin: 0 auto; }
      .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; }
      .header { padding: 36px 40px 20px; border-bottom: 1px solid #e2e8f0; }
      .brand { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 18px; }
      .title { font-size: 22px; font-weight: 700; line-height: 1.3; }
      .subtitle { margin-top: 8px; font-size: 14px; color: #475569; line-height: 1.6; }
      .body { padding: 28px 40px; }
      .pill { display: inline-block; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #047857; margin-bottom: 18px; }
      .section { margin-top: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; }
      .row { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; line-height: 1.6; margin-top: 8px; }
      .label { color: #64748b; }
      .value { color: #0f172a; font-weight: 600; word-break: break-word; }
      .btn {
        display: block;
        width: 100%;
        background: #2563eb;
        color: #ffffff !important;
        text-decoration: none;
        text-align: center;
        font-size: 14px;
        font-weight: 700;
        padding: 14px 18px;
        border-radius: 10px;
        margin-top: 18px;
      }
      .hint { margin-top: 14px; font-size: 12px; color: #64748b; line-height: 1.6; }
      .footer { padding: 18px 40px; border-top: 1px solid #e2e8f0; background: #f8fafc; }
      .footer p { font-size: 12px; color: #64748b; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <div class="brand">John Miko's Place</div>
          <div class="title">Your staff account has been reactivated</div>
          <div class="subtitle">
            Hi{{#if name}} {{name}}{{/if}}, your staff account access has been restored.
          </div>
        </div>

        <div class="body">
          <div class="pill">Access Restored</div>

          <div class="section">
            <div class="row">
              <div class="label">Email</div>
              <div class="value">{{email}}</div>
            </div>
            {{#if role}}
            <div class="row">
              <div class="label">Role</div>
              <div class="value">{{role}}</div>
            </div>
            {{/if}}
            {{#if expertise}}
            <div class="row">
              <div class="label">Expertise</div>
              <div class="value">{{expertise}}</div>
            </div>
            {{/if}}
          </div>

          {{#if loginUrl}}
          <a class="btn" href="{{loginUrl}}">Open Staff Login</a>
          {{/if}}

          <div class="hint">
            You can sign in again using your existing credentials.
          </div>
        </div>

        <div class="footer">
          <p>This email was sent to {{email}}.</p>
        </div>
      </div>
    </div>
  </body>
</html>
