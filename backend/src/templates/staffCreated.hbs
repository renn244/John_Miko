<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Account Created</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 560px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px;">
            <tr>
              <td style="padding: 36px 40px 20px; border-bottom: 1px solid #e2e8f0;">
                {{#if logoUrl}}
                <img src="{{logoUrl}}" alt="John Miko's Place" width="160" style="display: block; width: 160px; max-width: 100%; height: auto; margin: 0 0 18px; border: 0; outline: none; text-decoration: none;" />
                {{else}}
                <div style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 18px;">John Miko's Place</div>
                {{/if}}
                <div style="font-size: 22px; font-weight: 700; line-height: 1.3; color: #0f172a;">
                  Your staff account is ready
                </div>
                <div style="margin-top: 8px; font-size: 14px; line-height: 1.6; color: #475569;">
                  Hi{{#if name}} {{name}}{{/if}}, your staff account has been {{accountAction}}. Use the details below to sign in.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 28px 40px;">
                <div style="display: inline-block; background-color: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #334155; margin-bottom: 18px;">
                  Staff Access
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Email</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-all;">{{email}}</td>
                        </tr>
                        {{#if role}}
                        <tr>
                          <td style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #64748b; vertical-align: top;">Role</td>
                          <td align="right" style="padding-top: 8px; font-size: 13px; line-height: 1.6; color: #0f172a; font-weight: 600; vertical-align: top; word-break: break-word;">{{role}}</td>
                        </tr>
                        {{/if}}
                      </table>
                    </td>
                  </tr>
                </table>

                {{#if temporaryPassword}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 16px;">
                      <div style="font-size: 13px; line-height: 1.6; color: #64748b;">Temporary password</div>
                      <div style="margin-top: 10px; background-color: #0b1220; color: #e2e8f0; border-radius: 10px; padding: 12px 14px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; font-size: 12px;">
                        {{temporaryPassword}}
                      </div>
                      <div style="margin-top: 14px; background-color: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; border-radius: 12px; padding: 12px 14px; font-size: 12px; line-height: 1.6;">
                        For security, change your password immediately after signing in.
                      </div>
                    </td>
                  </tr>
                </table>
                {{/if}}

                {{#if loginUrl}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px;">
                  <tr>
                    <td align="center" bgcolor="#2563eb" style="border-radius: 10px;">
                      <a href="{{loginUrl}}" style="display: block; padding: 14px 18px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">Open Staff Login</a>
                    </td>
                  </tr>
                </table>
                {{/if}}

                {{#if setPasswordUrl}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 18px;">
                  <tr>
                    <td align="center" bgcolor="#2563eb" style="border-radius: 10px;">
                      <a href="{{setPasswordUrl}}" style="display: block; padding: 14px 18px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">Set Your Password</a>
                    </td>
                  </tr>
                </table>
                {{/if}}

                <div style="margin-top: 20px; border-top: 1px solid #e2e8f0;"></div>

                {{#if loginUrl}}
                <div style="margin-top: 14px; font-size: 12px; line-height: 1.6; color: #64748b;">
                  If the button doesn't work, copy and paste this link into your browser:
                  <br />
                  <a href="{{loginUrl}}" style="color: #2563eb; word-break: break-all;">{{loginUrl}}</a>
                </div>
                {{/if}}

                <div style="margin-top: 14px; font-size: 12px; line-height: 1.6; color: #64748b;">
                  If you didn't expect this email, you can ignore it.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 18px 40px; border-top: 1px solid #e2e8f0; background-color: #f8fafc; font-size: 12px; line-height: 1.6; color: #64748b;">
                This email was sent to {{email}}.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
