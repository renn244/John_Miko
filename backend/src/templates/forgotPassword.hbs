<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Password Reset Request</title>
    <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                background-color: #f8fafc;
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
                color: #0f172a;
                padding: 40px 16px;
            }

            .wrapper {
                max-width: 520px;
                margin: 0 auto;
            }

            .card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                overflow: hidden;
            }

            .header {
                padding: 36px 40px 28px;
                border-bottom: 1px solid #e2e8f0;
            }

            .logo {
                font-size: 13px;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: #64748b;
                margin-bottom: 28px;
            }

            .header h1 {
                font-size: 22px;
                font-weight: 600;
                color: #0f172a;
                line-height: 1.3;
            }

            .header p {
                margin-top: 8px;
                font-size: 14px;
                color: #475569;
                line-height: 1.6;
            }

            .body {
                padding: 32px 40px;
            }

            .email-tag {
                display: inline-block;
                background: #f1f5f9;
                border: 1px solid #e2e8f0;
                border-radius: 6px;
                padding: 6px 12px;
                font-size: 12px;
                color: #334155;
                margin-bottom: 24px;
            }

            .body p {
                font-size: 14px;
                color: #334155;
                line-height: 1.7;
                margin-bottom: 28px;
            }

            .btn {
                display: block;
                width: 100%;
                background: #2563eb;
                color: #ffffff;
                text-decoration: none;
                text-align: center;
                font-size: 14px;
                font-weight: 600;
                padding: 14px 24px;
                border-radius: 10px;
                letter-spacing: 0.02em;
            }

            .btn:hover { background: #1d4ed8; }

            .divider {
                margin: 28px 0;
                border: none;
                border-top: 1px solid #e2e8f0;
            }

            .fallback {
                font-size: 12px;
                color: #64748b;
                line-height: 1.6;
            }

            .fallback a {
                color: #2563eb;
                word-break: break-all;
            }

            .expiry {
                margin-top: 20px;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 12px;
                color: #64748b;
            }

            .expiry-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #2563eb;
                flex-shrink: 0;
            }

            .footer {
                padding: 20px 40px;
                border-top: 1px solid #e2e8f0;
                background: #f8fafc;
            }

            .footer p {
                font-size: 12px;
                color: #64748b;
                line-height: 1.6;
            }
        </style>
    </head>
    <body>
        <div class="wrapper">
            <div class="card">

                <div class="header">
                    <div class="logo">John Miko's Place</div>
                    <h1>Reset your password</h1>
                    <p>We received a request to reset the password for your account.</p>
                </div>

                <div class="body">
                    <div class="email-tag">{{ email }}</div>

                    <p>
                        Click the button below to choose a new password. This link is only valid for <strong style="color: #0f172a;">1 hour</strong> and can only be used once.
                    </p>

                    <a href="{{ confirmationUrl }}" class="btn">Reset Password</a>

                    <hr class="divider" />

                    <p class="fallback">
                        If the button doesn't work, copy and paste this link into your browser:
                        <br />
                        <a href="{{ confirmationUrl }}">{{ confirmationUrl }}</a>
                    </p>

                    <div class="expiry">
                        <div class="expiry-dot"></div>
                        If you didn't request this, you can safely ignore this email. Your password won't change.
                    </div>
                </div>

                <div class="footer">
                    <p>This email was sent to {{ email }} · If you have concerns, contact support.</p>
                </div>

            </div>
        </div>
    </body>
</html>
