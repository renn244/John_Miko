<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Password Reset Request</title>
    <style>
            @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono&display=swap');

            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                background-color: #0f0f0f;
                font-family: 'DM Sans', sans-serif;
                color: #e8e8e8;
                padding: 40px 16px;
            }

            .wrapper {
                max-width: 520px;
                margin: 0 auto;
            }

            .card {
                background: #171717;
                border: 1px solid #2a2a2a;
                border-radius: 16px;
                overflow: hidden;
            }

            .header {
                padding: 36px 40px 28px;
                border-bottom: 1px solid #222;
            }

            .logo {
                font-family: 'DM Mono', monospace;
                font-size: 13px;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: #666;
                margin-bottom: 28px;
            }

            .header h1 {
                font-size: 22px;
                font-weight: 600;
                color: #f0f0f0;
                line-height: 1.3;
            }

            .header p {
                margin-top: 8px;
                font-size: 14px;
                color: #888;
                line-height: 1.6;
            }

            .body {
                padding: 32px 40px;
            }

            .email-tag {
                display: inline-block;
                background: #1e1e1e;
                border: 1px solid #2e2e2e;
                border-radius: 6px;
                padding: 6px 12px;
                font-family: 'DM Mono', monospace;
                font-size: 12px;
                color: #aaa;
                margin-bottom: 24px;
            }

            .body p {
                font-size: 14px;
                color: #999;
                line-height: 1.7;
                margin-bottom: 28px;
            }

            .btn {
                display: block;
                width: 100%;
                background: #f0f0f0;
                color: #0f0f0f;
                text-decoration: none;
                text-align: center;
                font-size: 14px;
                font-weight: 600;
                padding: 14px 24px;
                border-radius: 10px;
                letter-spacing: 0.02em;
            }

            .divider {
                margin: 28px 0;
                border: none;
                border-top: 1px solid #222;
            }

            .fallback {
                font-size: 12px;
                color: #555;
                line-height: 1.6;
            }

            .fallback a {
                color: #777;
                word-break: break-all;
            }

            .expiry {
                margin-top: 20px;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 12px;
                color: #555;
            }

            .expiry-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #f59e0b;
                flex-shrink: 0;
            }

            .footer {
                padding: 20px 40px;
                border-top: 1px solid #1e1e1e;
                background: #111;
            }

            .footer p {
                font-size: 12px;
                color: #444;
                line-height: 1.6;
            }
        </style>
    </head>
    <body>
        <div class="wrapper">
            <div class="card">

                <div class="header">
                    <div class="logo">Your App</div>
                    <h1>Reset your password</h1>
                    <p>We received a request to reset the password for your account.</p>
                </div>

                <div class="body">
                    <div class="email-tag">{{ email }}</div>

                    <p>
                        Click the button below to choose a new password. This link is only valid for <strong style="color: #ccc;">1 hour</strong> and can only be used once.
                    </p>

                    <a href="{{ confirmationUrl }}" class="btn">Reset Password</a>

                    <hr class="divider" />

                    <p class="fallback">
                        If the button doesn't work, copy and paste this link into your browser:
                        <br />
                        <a href="{{ confirmationUrl }}">{{ confirmationUrl }}</a>
                    </p>

                    <div class="expiry">
                        <div class="expiry-dot"></div>
                        If you didn't request this, you can safely ignore this email. Your password won't change.
                    </div>
                </div>

                <div class="footer">
                    <p>This email was sent to {{ email }} · If you have concerns, contact support.</p>
                </div>

            </div>
        </div>
    </body>
</html>
