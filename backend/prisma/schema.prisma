// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  KITCHEN_STAFF
  RESORT_STAFF
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String      @id @default(cuid())
  email     String   @unique
  name      String?
  contactNo String   
  password  String
  role      Role     @default(GUEST)
  status    UserStatus @default(ACTIVE)

  forgotPasswordTokens PasswordResetToken[]

  // for guests, this will be their bookings and feedbacks.
  bookings  Booking[]
  guestFeedbacks Feedback[]

  // for staff, this will be the reports they made
  reports   Report[]

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum AccommodationType {
  Room
  Cottage
  EventHall
}

enum AccommodationAvailability {
  Available
  Unavailable
  Maintenance
}

model Accommodation {
  id            String  @id @default(cuid())
  name          String
  description   String?
  imageUrl      String // could be virtual tour field, but for now just photos

  type          AccommodationType
  capacity      Int
  price         Int

  amenities     String[]  @default([]) 

  availability  AccommodationAvailability
  
  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PaymentType {
  Full
  Partial
}

enum BookingTimeSlot {
  DayStay
  OverNight
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

model Booking {
  id              String @id @default(cuid())

  userId          String
  user            User  @relation(fields: [userId], references: [id])

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  bookedAccommodation BookedAccommodation?
  preOrders         PreOrderMenuItem[]
  feedback          Feedback?
  reports           Report[]

  guestName       String
  email           String
  contactNo       String

  numberOfGuests  Int
  specialRequests String?

  bookingDate      DateTime @db.Date
  timeSlot         BookingTimeSlot
  status           BookingStatus @default(Pending)
  paymentType      PaymentType
  payment          Payment?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentStatus {
  Pending
  Completed
  Failed
}

model Payment {
  id                  String   @id @default(cuid())
  
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)


  accommodationAmount Int
  preOrderAmount      Int
  guestFeeAmount      Int

  amountPaid          Int
  amountToPaid        Int
  totalAmount         Int

  paymentStatus       PaymentStatus @default(Pending)
  paymentId           String   @unique // from payment gateway

  paidAt              DateTime?
  createdAt           DateTime @default(now())
}

// Snapshot of accommodation details at the time of booking to avoid issues with price changes or availability changes
model BookedAccommodation {
  id            String   @id @default(cuid())
  
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  imageUrl      String
  type          AccommodationType
  capacity      Int
  price         Int
  amenities     String[] @default([])

  createdAt     DateTime @default(now())
}

model PreOrderMenuItem {
  id            String   @id @default(cuid())
  
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name          String
  description   String
  category      String
  price         Int
  
  quantity      Int

  createdAt     DateTime @default(now())
}

enum ReportType  {
  checkIn
  checkOut
}

model Report {
  id            String   @id @default(cuid())

  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId        String // for staff, to identify who made the report. for accountability purposes
  user          User   @relation(fields: [userId], references: [id])

  title         String
  proofImages   String[]
  description   String

  type    ReportType

  createdAt     DateTime @default(now())
} 

enum MaintenanceStatus {
  Pending
  InProgress
  Completed
  Closed
}

enum MaintenancePriority {
  Low
  Medium
  High
}

model Maintenance {
  id            String   @id @default(cuid())

  title         String
  imagesUrl     String[]
  description   String

  status        MaintenanceStatus @default(Pending)
  priority      MaintenancePriority

  notes         String?            // general notes
  resolutionNotes String?          // final fix notes

  startedAt     DateTime?
  resolvedAt    DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum MenuItemAvailability {
  Available
  Unavailable
}

model MenuItem {
  id            String   @id @default(cuid())
  imageUrl      String
  name          String
  description   String

  category      String
  price         Int
  availability  MenuItemAvailability @default(Available)

  createdAt     DateTime @default(now())
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookingId     String  @unique
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  rating        Int     
  comment       String?

  createdAt     DateTime @default(now())
}

// CHATBOT
model Rules {
  id              String   @id @default(cuid())
  
  name            String
  keywords        String[]
  response        String
  quickReplies    String[] @default([])
  isActive        Boolean @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}