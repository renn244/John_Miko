generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  GUEST
}

// we might want to divide this into multiple models in the future, but for now we can just have one user model with a role field
model User {
  id        String      @id @default(cuid())
  email     String   @unique
  name      String?
  contactNo String    @default("09")
  password  String
  role      Role     @default(GUEST)

  forgotPasswordTokens PasswordResetToken[]

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}