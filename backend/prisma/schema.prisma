// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  GUEST
}

model User {
  id        String      @id @default(cuid())
  email     String   @unique
  name      String?
  contactNo String   
  password  String
  role      Role     @default(GUEST)

  forgotPasswordTokens PasswordResetToken[]

  bookings  Booking[]

  createdAt DateTime @default(now())
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum AccommodationType {
  Room
  Cottage
  EventHall
}

enum AccommodationAvailability {
  Available
  Unavailable
  Maintenance
}

model Accommodation {
  id            String  @id @default(cuid())
  name          String
  description   String?
  imageUrl      String // could be virtual tour field, but for now just photos

  type          AccommodationType
  capacity      Int
  price         Int

  amenities     String[]  @default([]) 

  availability  AccommodationAvailability
  
  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PaymentType {
  Full
  Partial
}

enum BookingTimeSlot {
  DayStay
  OverNight
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

model Booking {
  id              String @id @default(cuid())

  userId          String
  user            User  @relation(fields: [userId], references: [id])

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  bookedAccommodation BookedAccommodation?

  guestName       String
  email           String
  contactNo       String

  numberOfGuests  Int
  specialRequests String?

  bookingDate      DateTime @db.Date
  timeSlot         BookingTimeSlot
  status           BookingStatus @default(Pending)
  paymentType      PaymentType


  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Snapshot of accommodation details at the time of booking to avoid issues with price changes or availability changes
model BookedAccommodation {
  id            String   @id @default(cuid())
  
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  imageUrl      String
  type          AccommodationType
  capacity      Int
  price         Int
  amenities     String[] @default([])

  createdAt     DateTime @default(now())
}

enum MenuItemAvailability {
  Available
  Unavailable
}

model MenuItem {
  id            String   @id @default(cuid())
  imageUrl      String
  name          String
  description   String

  category      String
  price         Int
  availability  MenuItemAvailability @default(Available)

  createdAt     DateTime @default(now())
}