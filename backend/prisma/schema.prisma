// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  KITCHEN_STAFF
  RESORT_STAFF
  MAINTENANCE_STAFF
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String      @id @default(cuid())
  email     String   @unique
  name      String?
  contactNo String   
  password  String
  role      Role     @default(GUEST)
  status    UserStatus @default(ACTIVE)
  expertise MaintenanceExpertise?
  expoPushToken String?

  forgotPasswordTokens PasswordResetToken[]

  // for guests, this will be their bookings and feedbacks.
  bookings  Booking[]
  guestFeedbacks Feedback[]

  // for staff, this will be the reports they made
  reports   Report[] @relation("User")
  reviewedReports Report[] @relation("ReviewedBy")
  assignedMaintenances Maintenance[] @relation("AssignedMaintenanceStaff")


  verifiedPayments Payment[]

  knowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocumentAuthor")

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum AccommodationType {
  Room
  Cottage
  EventHall
}

model Accommodation {
  id            String  @id @default(cuid())
  name          String
  description   String?
  imageUrl      String // could be virtual tour field, but for now just photos

  type          AccommodationType
  capacity      Int
  price         Int
  isGuestFeeWaived Boolean @default(false)

  amenities     String[]  @default([]) 
  
  stayOptions   AccommodationStayOption[]
  closures      Closure[]
  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AccommodationStayOption {
  id              String  @id @default(cuid())
  
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  code            String
  label           String
  
  durationHours   Int?
  
  startTime       DateTime? @db.Time
  endTime         DateTime? @db.Time
  
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  bookings         Booking[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accommodationId, code])
  @@unique([id, accommodationId])
  @@index([accommodationId])
  @@index([accommodationId, isActive, sortOrder])
}

enum ClosureType {
  Close
  Private
}

model Closure {
  id                String   @id @default(cuid())

  accommodationId   String?
  accommodation     Accommodation? @relation(fields: [accommodationId], references: [id])

  date              DateTime @db.Date
  type              ClosureType @default(Close)
  reason            String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([accommodationId, date]) // prevent overlapping closures for the same accommodation
  @@index([accommodationId])
  @@index([date])
}

enum PaymentType {
  Full
  Partial
}

enum PaymentMethodType {
  GCASH
  MAYA
  BANK
  CASH
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

model Booking {
  id              String @id @default(cuid())
  referenceCode   String? @unique

  userId          String?
  user            User?  @relation(fields: [userId], references: [id])

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  bookedAccommodation BookedAccommodation?
  preOrders         PreOrderMenuItem[]
  addOns            BookingAddOn[]

  feedback          Feedback?
  reports           Report[]

  guestName       String
  email           String
  contactNo       String

  adultGuests     Int
  kidGuests       Int
  seniorGuest     Int

  numberOfGuests  Int
  specialRequests String?

  bookingDate      DateTime @db.Date

  stayOptionId     String
  stayOption       AccommodationStayOption @relation(fields: [stayOptionId, accommodationId], references: [id, accommodationId])
  stayOptionCodeSnapshot  String
  stayOptionLabelSnapshot String
  stayDurationHoursSnapshot Int?
  guestFeeWaivedSnapshot Boolean @default(false)

  status           BookingStatus @default(Pending)
  paymentType      PaymentType
  payment          Payment?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accommodationId, bookingDate])
  @@index([userId])
  @@index([status])
  @@index([bookingDate, status])
  @@index([bookingDate, stayOptionId])
}

enum PaymentStatus {
  Pending
  Approved
  Rejected
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  type          PaymentMethodType
  accountName   String?
  accountNumber String?
  instructions  String?
  qrCodeUrl     String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Payment {
  id                  String   @id @default(cuid())
  
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  methodId            String?
  method              PaymentMethod? @relation(fields: [methodId], references: [id])


  accommodationAmount Int  
  preOrderAmount      Int
  addOnAmount         Int
  guestFeeAmount      Int

  amountPaid          Int
  amountToPaid        Int
  totalAmount         Int

  status              PaymentStatus @default(Pending)
  referenceNumber     String?  @unique
  proofImageUrl       String?
  rejectionNote       String?
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?    @relation(fields: [verifiedById], references: [id])

  paidAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([methodId])
  @@index([status])
}

// Snapshot of accommodation details at the time of booking to avoid issues with price changes or availability changes
model BookedAccommodation {
  id            String   @id @default(cuid())
  
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  imageUrl      String
  type          AccommodationType
  capacity      Int
  price         Int
  amenities     String[] @default([])

  createdAt     DateTime @default(now())
}

model BookingAddOn {
  id                    String  @id @default(cuid())

  bookingId             String
  booking               Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  addOnServiceId        String
  addOnService          AddOnService @relation(fields: [addOnServiceId], references: [id])

  quantity              Int

  // Snapshots
  name                  String
  price                 Int

  createdAt             DateTime  @default(now())

  @@unique([bookingId, addOnServiceId]) // prevent duplicates of many services in one booking
  @@index([bookingId])
  @@index([addOnServiceId])
}


enum PreOrderStatus {
  Pending
  Completed
}

model PreOrderMenuItem {
  id            String   @id @default(cuid())
  
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name          String
  description   String
  category      String
  price         Int
  status        PreOrderStatus @default(Pending)

  quantity      Int

  createdAt     DateTime @default(now())
}

enum ReportStatus {
  Pending
  Approved
  Rejected
}

enum ReportType  {
  checkIn
  checkOut
  maintenance
}

enum ReportSeverity {
  Low
  Medium
  High
}

model Report {
  id            String   @id @default(cuid())

  bookingId     String?
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  userId        String 
  user          User   @relation("User", fields: [userId], references: [id])

  maintenanceId String? @unique
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  title         String
  proofImages   String[]
  description   String

  type        ReportType
  status      ReportStatus @default(Pending)
  severity    ReportSeverity 

  rejectionNote String?
  reviewedAt    DateTime?
  reviewedById   String?
  reviewedBy   User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([ status, severity])
}

enum MaintenanceStatus {
  Pending
  InProgress
  Completed
  Closed
}

enum MaintenancePriority {
  Low
  Medium
  High
}

enum MaintenanceExpertise {
  Electrical
  Pool
  Construction
}

model Maintenance {
  id            String   @id @default(cuid())

  title         String
  imagesUrl     String[]
  description   String

  status        MaintenanceStatus @default(Pending)
  priority      MaintenancePriority
  expertise     MaintenanceExpertise

  assignedToId  String?
  assignedTo    User? @relation("AssignedMaintenanceStaff", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes         String?            // general notes
  resolutionNotes String?          // final fix notes
  resolutionProofImages String[] @default([])

  startedAt     DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  
  report        Report? 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expertise])
  @@index([assignedToId])
  @@index([status, expertise])
}

enum MenuItemAvailability {
  Available
  Unavailable
}

model MenuItem {
  id            String   @id @default(cuid())
  imageUrl      String
  name          String
  description   String

  category      String
  price         Int
  availability  MenuItemAvailability @default(Available)

  createdAt     DateTime @default(now())
}

model AddOnService {
  id            String  @id @default(cuid())

  imageUrl      String
  name          String
  description   String?
  
  price         Int
  quantity      Int
  isActive      Boolean @default(true)

  Booking       BookingAddOn[]

  createdAt     DateTime @default(now())
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookingId     String  @unique
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  rating        Int     
  comment       String?

  createdAt     DateTime @default(now())
}

model KnowledgeDocument {
  id          String           @id @default(cuid())
  title       String
  category    String
  contentHtml String           @db.Text
  contentText String           @db.Text
  isPublished Boolean          @default(false)
  createdById String
  createdBy   User             @relation("KnowledgeDocumentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  chunks      KnowledgeChunk[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished, updatedAt])
  @@index([createdById])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  heading    String?
  content    String            @db.Text
  embedding  Unsupported("vector(768)")

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}
