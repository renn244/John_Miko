generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  GUEST
}

// we might want to divide this into multiple models in the future, but for now we can just have one user model with a role field
model User {
  id        String      @id @default(cuid())
  email     String   @unique
  name      String?
  contactNo String    @default("09")
  password  String
  role      Role     @default(GUEST)

  forgotPasswordTokens PasswordResetToken[]

  // bookings  Booking[]

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum AccommodationType {
  Room
  Cottage
  EventHall
}

enum AccommodationAvailability {
  Occupied
  Available
  OutofService
}

model Accommodation {
  id            String  @id @default(cuid())
  name          String
  description   String?
  imageUrl      String // could be virtual tour field, but for now just photos

  type          AccommodationType
  capacity      Int
  price         Int

  amenities     String[]  @default([]) 

  availability  AccommodationAvailability
  
  // bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

