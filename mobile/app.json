{
  "expo": {
    "name": "JMPort",
    "slug": "jmport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jmport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E33F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.renn244.jmport"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JMPort staff app to select proof photos for reports.",
          "cameraPermission": "Allow JMPort staff app to take proof photos for reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6fcf781-f655-4d19-a852-4f5a59ce632d"
      }
    }
  }
}
